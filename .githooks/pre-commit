#!/usr/bin/env bash
# Git pre-commit hook for SunsetHue.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Runs the fast staged-files quality gate before every commit:
#   swiftformat --lint + swiftlint --strict on the staged Swift files only.
# Full tests + shell checks run in CI (see .github/workflows/ci.yml) and can be
# run locally with ./scripts/quality.sh --full.
#
# Skip in emergencies with: git commit --no-verify
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec "$ROOT/scripts/quality.sh" --staged
